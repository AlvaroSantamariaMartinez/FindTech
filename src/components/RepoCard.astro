---
interface Props {
  nombre: string;
  descripcion: string;
  lenguaje: string;
  estrellas: number;
  url: string;
}
const { nombre, descripcion, lenguaje, estrellas, url } = Astro.props;

// Color del punto por lenguaje (como en GitHub).
const colorLenguaje: Record<string, string> = {
  Python: '#3572A5',
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  Rust: '#dea584',
  Go: '#00ADD8',
  'C++': '#f34b7d',
  Cuda: '#3A4E3A',
  Jupyter: '#DA5B0B',
};
const punto = colorLenguaje[lenguaje] ?? '#8b949e';

const estrellasFmt =
  estrellas >= 1000 ? `${(estrellas / 1000).toFixed(1)}k` : `${estrellas}`;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="glass glow-hover-purple group block p-4"
>
  <div class="mb-2 flex items-start justify-between gap-2">
    <span class="font-mono text-sm font-semibold text-purple-soft transition-colors group-hover:text-purple">
      {nombre}
    </span>
    <span class="flex shrink-0 items-center gap-1 font-mono text-xs text-muted">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" class="text-yellow-500/80">
        <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
      </svg>
      {estrellasFmt}
    </span>
  </div>

  <p class="mb-3 line-clamp-2 text-sm leading-relaxed text-muted">
    {descripcion}
  </p>

  <div class="flex items-center gap-1.5 font-mono text-xs text-faint">
    <span class="inline-block h-2.5 w-2.5 rounded-full" style={`background:${punto}`}></span>
    {lenguaje}
  </div>
</a>
