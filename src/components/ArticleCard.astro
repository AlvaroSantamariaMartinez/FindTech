---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  articulo: CollectionEntry<'articulos'>;
  minutos: number;
}
const { articulo, minutos } = Astro.props;
const { data } = articulo;
const base = import.meta.env.BASE_URL;

const fecha = data.fecha.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class="glass glow-hover group overflow-hidden">
  <a href={`${import.meta.env.BASE_URL}/articulos/${articulo.id}/`} class="block">
    <!-- Miniatura -->
    <div class="relative aspect-[16/9] overflow-hidden bg-elevated">
      {data.imagen && (
        <Image
          src={data.imagen}
          alt={data.titulo}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          widths={[400, 800]}
          sizes="(max-width: 768px) 100vw, 400px"
        />
      )}
      {!data.imagen && data.imagenExterna && (
        <img
          src={data.imagenExterna}
          alt={data.titulo}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      )}
      {!data.imagen && !data.imagenExterna && (
        <div class="grid h-full w-full place-items-center bg-gradient-to-br from-cyan/10 to-purple/10">
          <span class="font-mono text-4xl text-faint">&lt;/&gt;</span>
        </div>
      )}
    </div>

    <!-- Cuerpo -->
    <div class="p-5">
      <div class="mb-3 flex flex-wrap gap-1.5">
        {data.tags.slice(0, 2).map((t) => <Tag nombre={t} />)}
      </div>

      <h3 class="mb-2 text-lg font-bold leading-snug text-ink transition-colors group-hover:text-cyan">
        {data.titulo}
      </h3>

      <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-muted">
        {data.descripcion}
      </p>

      <div class="flex items-center gap-3 font-mono text-xs text-faint">
        <span>{fecha}</span>
        <span class="text-cyan/40">·</span>
        <span>{minutos} min de lectura</span>
      </div>
    </div>
  </a>
</article>
