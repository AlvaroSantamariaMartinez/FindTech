---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  articulo: CollectionEntry<'articulos'>;
}
const { articulo } = Astro.props;
const { data } = articulo;
const base = import.meta.env.BASE_URL;

const fecha = data.fecha.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<section class="relative overflow-hidden">
  <!-- Imagen de fondo difuminada -->
  <div class="absolute inset-0 -z-10">
    {data.imagen && (
      <Image
        src={data.imagen}
        alt=""
        class="h-full w-full object-cover opacity-30 blur-2xl scale-110"
        loading="eager"
      />
    )}
    {!data.imagen && data.imagenExterna && (
      <img src={data.imagenExterna} alt="" class="h-full w-full object-cover opacity-30 blur-2xl scale-110" />
    )}
    <!-- Halos de color y viñeta -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-void/60 to-void"></div>
    <div class="absolute -left-32 top-0 h-96 w-96 rounded-full bg-cyan/20 blur-[120px]"></div>
    <div class="absolute -right-32 bottom-0 h-96 w-96 rounded-full bg-purple/20 blur-[120px]"></div>
  </div>

  <div class="mx-auto max-w-6xl px-5 pb-16 pt-20 sm:pt-28">
    <p class="eyebrow mb-5">destacado_de_la_semana</p>

    <div class="mb-5 flex flex-wrap gap-2">
      {data.tags.map((t) => <Tag nombre={t} />)}
    </div>

    <h1 class="max-w-3xl text-4xl font-bold leading-tight text-ink sm:text-6xl">
      {data.titulo}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      {data.descripcion}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a
  <a href={`/FindTech/articulos/${articulo.id}/`} class="group inline-flex items-center gap-2 rounded-lg border border-cyan/50 bg-cyan/10 px-6 py-3 font-mono text-sm font-semibold text-cyan transition-all hover:bg-cyan/20 hover:shadow-[0_0_30px_-8px_rgba(34,211,238,0.7)]">
  class="group inline-flex items-center gap-2 rounded-lg border border-cyan/50 bg-cyan/10 px-6 py-3 font-mono text-sm font-semibold text-cyan transition-all hover:bg-cyan/20 hover:shadow-[0_0_30px_-8px_rgba(34,211,238,0.7)]"
>
        Leer más
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
      <span class="font-mono text-sm text-faint">{fecha}</span>
    </div>
  </div>
</section>
